<?xml version="1.0" encoding="utf-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:ToDo.Views"
       x:Class="ToDo.AppShell"
       Shell.FlyoutBehavior="Disabled">

    <!-- Authentication Pages -->
    <ShellContent
        Title="Sign In"
        ContentTemplate="{DataTemplate views:SignInPage}"
        Route="signin" />

    <!-- Main Tab Bar -->
    <TabBar>
        <Tab Title="ToDo" Icon="todo.png">
            <ShellContent 
                Title="ToDo"
                ContentTemplate="{DataTemplate views:ToDoTab}"
                Route="todo" />
        </Tab>
        
        <Tab Title="Completed" Icon="check.png">
            <ShellContent 
                Title="Completed"
                ContentTemplate="{DataTemplate views:Completed}"
                Route="completed" />
        </Tab>
    </TabBar>

    <!-- Register additional pages for navigation -->
    <ShellContent Title="Add Task"
                  ContentTemplate="{DataTemplate views:AddTaskPage}"
                  Route="AddTaskPage" />
    <ShellContent Title="Edit Task"
                  ContentTemplate="{DataTemplate views:EditTaskPage}"
                  Route="EditTaskPage" />
</Shell>


