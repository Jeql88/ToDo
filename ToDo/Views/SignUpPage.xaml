<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ToDo.Views.SignUpPage">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
            <Image Source="todo_background.jpg" HeightRequest="200" Aspect="AspectFill" />
            <Label Text="Sign Up" FontSize="24" FontAttributes="Bold" />
            <Entry x:Name="FirstNameEntry" Placeholder="First Name" />
            <Entry x:Name="LastNameEntry" Placeholder="Last Name" />
            <Entry x:Name="EmailEntry" Placeholder="Email address" Keyboard="Email" />
            <Entry x:Name="PasswordEntry" Placeholder="Password" IsPassword="True" />
            <Entry x:Name="ConfirmPasswordEntry" Placeholder="Confirm Password" IsPassword="True" />
            <Button Text="Sign Up" BackgroundColor="Black" TextColor="White" Clicked="OnSignUpClicked" />
            <HorizontalStackLayout HorizontalOptions="Center">
                <Label Text="Already have an account? " />
                <Label Text="Sign In" TextColor="Black" FontAttributes="Bold">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSignInTapped" />
                    </Label.GestureRecognizers>
                </Label>
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>