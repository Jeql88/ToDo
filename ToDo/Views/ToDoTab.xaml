<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ToDo.Views.ToDoTab"
             xmlns:models="clr-namespace:ToDo.Models"
             BackgroundColor="{DynamicResource PageBackgroundColor}">

       <Grid RowDefinitions="Auto,*,Auto">
              <!-- Header -->
              <Label Text="ToDo"
                     Grid.Row="0"
                     HorizontalOptions="Center"
                     VerticalOptions="Center"
                     FontSize="20"
                     FontAttributes="Bold"
                     Margin="0,10"
                     TextColor="{DynamicResource PrimaryTextColor}"/>

              <!-- Task List -->
              <CollectionView Grid.Row="1"
                              ItemsSource="{Binding TodoItems}"
                              SelectionMode="None">
                     <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:TodoItem">
                                   <Grid Padding="10"
                                         BackgroundColor="{DynamicResource CardBackgroundColor}"
                                         Margin="10,5"
                                         ColumnDefinitions="*,Auto,Auto,Auto">
                                          <Grid.GestureRecognizers>
                                                 <TapGestureRecognizer
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=ItemTappedCommand}"
                                                        CommandParameter="{Binding .}"/>
                                          </Grid.GestureRecognizers>
                                          <VerticalStackLayout Grid.Column="0"
                                                               HorizontalOptions="Start"
                                                               VerticalOptions="Center"
                                                               Spacing="5">
                                                 <Label Text="{Binding Title}"
                                                        FontSize="18"
                                                        FontAttributes="Bold"
                                                        TextColor="{DynamicResource PrimaryTextColor}"
                                                        LineBreakMode="TailTruncation"/>
                                                 <Label Text="{Binding Details}"
                                                        FontSize="14"
                                                        TextColor="{DynamicResource SecondaryTextColor}"
                                                        LineBreakMode="TailTruncation"/>
                                          </VerticalStackLayout>
                                          <!-- Delete Icon -->
                                          <Grid Grid.Column="1"
                                                WidthRequest="40"
                                                HeightRequest="40"
                                                HorizontalOptions="Center"
                                                VerticalOptions="Center">
                                                 <ImageButton Source="trash.jpg"
                                                              BackgroundColor="Transparent"
                                                              Aspect="AspectFit"
                                                              WidthRequest="28"
                                                              HeightRequest="28"
                                                              Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=DeleteTodoCommand}"
                                                              CommandParameter="{Binding .}"/>
                                          </Grid>
                                          <!-- Check Icon -->
                                          <Grid Grid.Column="2"
                                                WidthRequest="40"
                                                HeightRequest="40"
                                                HorizontalOptions="Center"
                                                VerticalOptions="Center">
                                                 <ImageButton Source="check.png"
                                                              BackgroundColor="Transparent"
                                                              Aspect="AspectFit"
                                                              WidthRequest="24"
                                                              HeightRequest="24"
                                                              Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=ChangeStatusCommand}"
                                                              CommandParameter="{Binding .}"/>
                                          </Grid>
                                   </Grid>
                            </DataTemplate>
                     </CollectionView.ItemTemplate>
              </CollectionView>

              <!-- Floating Action Button (Add Button) -->
              <Button Grid.Row="1"
                      Grid.RowSpan="2"
                      Text="+"
                      FontSize="32"
                      FontAttributes="Bold"
                      CornerRadius="50"
                      WidthRequest="80"
                      HeightRequest="80"
                      BackgroundColor="#D8BFD8"
                      TextColor="Black"
                      HorizontalOptions="End"
                      VerticalOptions="End"
                      Margin="0,0,20,80"
                      Command="{Binding AddTodoCommand}"/>

              <!-- Footer with three tabs -->
              <Grid Grid.Row="2"
                    ColumnDefinitions="*,*,*"
                    BackgroundColor="{DynamicResource BottomTabBarColor}"
                    HeightRequest="80">

                     <!-- ToDo Tab -->
                     <VerticalStackLayout Grid.Column="0"
                                          HorizontalOptions="Center"
                                          VerticalOptions="Center"
                                          Spacing="5">
                            <Image Source="todo.png"
                                   WidthRequest="24"
                                   HeightRequest="24"
                                   HorizontalOptions="Center"/>
                            <Label Text="ToDo"
                                   FontSize="12"
                                   HorizontalOptions="Center"
                                   TextColor="Black"/>
                     </VerticalStackLayout>

                     <!-- Completed Tab -->
                     <VerticalStackLayout Grid.Column="1"
                                          HorizontalOptions="Center"
                                          VerticalOptions="Center"
                                          Spacing="5">
                            <ImageButton x:Name="completedButton"
                                         Source="check.png"
                                         WidthRequest="24"
                                         HeightRequest="24"
                                         HorizontalOptions="Center"
                                         BackgroundColor="Transparent"
                                         Clicked="OnCompleteTapped"/>
                            <Label Text="Completed"
                                   FontSize="12"
                                   HorizontalOptions="Center"
                                   TextColor="{DynamicResource PrimaryTextColor}"/>
                     </VerticalStackLayout>

                     <!-- Profile Tab -->
                     <VerticalStackLayout Grid.Column="2"
                                          HorizontalOptions="Center"
                                          VerticalOptions="Center"
                                          Spacing="5">
                            <ImageButton Source="profile.png"
                                         WidthRequest="24"
                                         HeightRequest="24"
                                         HorizontalOptions="Center"
                                         Clicked="OnProfileTapped"/>
                            <Label Text="Profile"
                                   FontSize="12"
                                   HorizontalOptions="Center"
                                   TextColor="{DynamicResource PrimaryTextColor}"/>
                     </VerticalStackLayout>
              </Grid>

              <!-- Loading Overlay -->
              <Grid x:Name="LoadingOverlay"
                    Grid.Row="0"
                    Grid.RowSpan="3"
                    BackgroundColor="#1A000000"
                    IsVisible="False"
                    VerticalOptions="FillAndExpand"
                    HorizontalOptions="FillAndExpand"
                    ZIndex="100">
                  <VerticalStackLayout
                      VerticalOptions="Center"
                      HorizontalOptions="Center"
                      Spacing="16">
                      <ActivityIndicator IsRunning="True"
                                         Color="{DynamicResource PrimaryTextColor}"
                                         WidthRequest="48"
                                         HeightRequest="48"
                                         VerticalOptions="Center"
                                         HorizontalOptions="Center"/>
                      <Label Text="Loading..."
                             FontSize="16"
                             TextColor="{DynamicResource PrimaryTextColor}"
                             HorizontalOptions="Center"
                             Opacity="0.7"/>
                  </VerticalStackLayout>
              </Grid>
    </Grid>
</ContentPage>