<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ToDo.Views.SignInPage">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
            <Image Source="todo_background.jpg" HeightRequest="200" Aspect="AspectFill" />
            <Label Text="Sign In" FontSize="24" FontAttributes="Bold" />
            <Entry x:Name="EmailEntry" Placeholder="Email address" Keyboard="Email" />
            <Entry x:Name="PasswordEntry" Placeholder="Password" IsPassword="True" />
            <Label Text="Forgot Password?" TextColor="Black" HorizontalOptions="Center" />
            <Button Text="Sign In"
                    Clicked="OnSignInClicked"
                    BackgroundColor="Black"
                    TextColor="White"/>
            <HorizontalStackLayout HorizontalOptions="Center">
                <Label Text="Don't have an account? " />
                <Label Text="Sign Up" TextColor="Black" FontAttributes="Bold">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSignUpTapped" />
                    </Label.GestureRecognizers>
                </Label>
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>