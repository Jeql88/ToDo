<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:ToDo.Models"
             x:Class="ToDo.Views.Completed"
             BackgroundColor="White">
       <Grid RowDefinitions="Auto,*,Auto">
              <!-- Header -->
              <Label Text="Completed Tasks"
                     Grid.Row="0"
                     HorizontalOptions="Center"
                     VerticalOptions="Center"
                     FontSize="20"
                     FontAttributes="Bold"
                     Margin="0,10"
                     TextColor="{DynamicResource PrimaryTextColor}"/>
              <!-- List -->
              <CollectionView Grid.Row="1"
                              ItemsSource="{Binding CompletedItems}"
                              SelectionMode="None">
                     <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:TodoItem">
                                   <Grid Padding="10"
                                         BackgroundColor="{DynamicResource CardBackgroundColor}"
                                         Margin="10,5"
                                         ColumnDefinitions="*,Auto,Auto">
                                          <Grid.GestureRecognizers>
                                                 <TapGestureRecognizer
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=ItemTappedCommand}"
                                                        CommandParameter="{Binding .}"/>
                                          </Grid.GestureRecognizers>
                                          <VerticalStackLayout Grid.Column="0"
                                                               HorizontalOptions="Start"
                                                               VerticalOptions="Center"
                                                               Spacing="5">
                                                 <Label Text="{Binding Title}"
                                                        FontSize="18"
                                                        FontAttributes="Bold"
                                                        TextColor="{DynamicResource PrimaryTextColor}"
                                                        LineBreakMode="TailTruncation"/>
                                                 <Label Text="{Binding Details}"
                                                        FontSize="14"
                                                        TextColor="{DynamicResource SecondaryTextColor}"
                                                        LineBreakMode="TailTruncation"/>
                                          </VerticalStackLayout>
                                          <Grid Grid.Column="1"
                                                WidthRequest="40"
                                                HeightRequest="40"
                                                HorizontalOptions="Center"
                                                VerticalOptions="Center">
                                                 <ImageButton Source="edit.png"
                                                              BackgroundColor="Transparent"
                                                              Aspect="AspectFit"
                                                              WidthRequest="28"
                                                              HeightRequest="28"
                                                              Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=EditCommand}"
                                                              CommandParameter="{Binding .}"/>
                                          </Grid>
                                          <Grid Grid.Column="2"
                                                WidthRequest="40"
                                                HeightRequest="40"
                                                HorizontalOptions="Center"
                                                VerticalOptions="Center">
                                                 <ImageButton Source="trash.jpg"
                                                              BackgroundColor="Transparent"
                                                              Aspect="AspectFit"
                                                              WidthRequest="28"
                                                              HeightRequest="28"
                                                              Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=DeleteCommand}"
                                                              CommandParameter="{Binding .}"/>
                                          </Grid>
                                   </Grid>
                            </DataTemplate>
                     </CollectionView.ItemTemplate>
              </CollectionView>
              <!-- Bottom Navigation Bar -->
              <Grid Grid.Row="2"
                    ColumnDefinitions="*,*,*"
                    BackgroundColor="{DynamicResource BottomTabBarColor}"
                    HeightRequest="80">
                     <!-- ToDo Tab -->
                     <VerticalStackLayout Grid.Column="0"
                                          HorizontalOptions="Center"
                                          VerticalOptions="Center"
                                          Spacing="5">
                            <ImageButton Source="todo.png"
                                         WidthRequest="24"
                                         HeightRequest="24"
                                         HorizontalOptions="Center"
                                         BackgroundColor="Transparent"
                                         Clicked="OnToDoTapped"/>
                            <Label Text="ToDo"
                                   FontSize="12"
                                   HorizontalOptions="Center"
                                   TextColor="{DynamicResource PrimaryTextColor}"/>
                     </VerticalStackLayout>
                     <!-- Completed Tab (current) -->
                     <VerticalStackLayout Grid.Column="1"
                                          HorizontalOptions="Center"
                                          VerticalOptions="Center"
                                          Spacing="5">
                            <Image Source="check.png"
                                   WidthRequest="24"
                                   HeightRequest="24"
                                   HorizontalOptions="Center"/>
                            <Label Text="Completed"
                                   FontSize="12"
                                   HorizontalOptions="Center"
                                   TextColor="Black"/>
                     </VerticalStackLayout>
                     <!-- Profile Tab -->
                     <VerticalStackLayout Grid.Column="2"
                                          HorizontalOptions="Center"
                                          VerticalOptions="Center"
                                          Spacing="5">
                            <ImageButton Source="profile.png"
                                         WidthRequest="24"
                                         HeightRequest="24"
                                         HorizontalOptions="Center"
                                         BackgroundColor="Transparent"
                                         Clicked="OnProfileTapped"/>
                            <Label Text="Profile"
                                   FontSize="12"
                                   HorizontalOptions="Center"
                                   TextColor="{DynamicResource PrimaryTextColor}"/>
                     </VerticalStackLayout>
              </Grid>
              <!-- Loading Overlay -->
              <Grid x:Name="LoadingOverlay"
                    BackgroundColor="#80000080"
                    IsVisible="False"
                    VerticalOptions="FillAndExpand"
                    HorizontalOptions="FillAndExpand"
                    ZIndex="100">
                     <Frame Padding="30"
                            CornerRadius="16"
                            BackgroundColor="#CC222222"
                            HorizontalOptions="Center"
                            VerticalOptions="Center">
                            <ActivityIndicator IsRunning="True"
                                               VerticalOptions="Center"
                                               HorizontalOptions="Center"
                                               Color="White"
                                               WidthRequest="60"
                                               HeightRequest="60"/>
                     </Frame>
              </Grid>
       </Grid>
</ContentPage>