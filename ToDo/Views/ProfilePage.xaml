<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ToDo.Views.ProfilePage"
             Title="Profile"
             BackgroundColor="White">

       <Grid RowDefinitions="*,80">
              <VerticalStackLayout Spacing="30"
                                   Padding="20"
                                   VerticalOptions="Center"
                                   Grid.Row="0">
                     <Frame HasShadow="False"
                            Padding="0"
                            CornerRadius="80"
                            HeightRequest="160"
                            WidthRequest="160"
                            HorizontalOptions="Center">
                            <Image Source="profilepic.jpeg"
                                   Aspect="AspectFill"
                                   HeightRequest="160"
                                   WidthRequest="160"/>
                     </Frame>
                     <Label x:Name="NameLabel"
                            Text=""
                            FontAttributes="Bold"
                            FontSize="24"
                            HorizontalOptions="Center"/>
                     <Label x:Name="EmailLabel"
                            Text=""
                            FontSize="14"
                            TextColor="Gray"
                            HorizontalOptions="Center"/>
                     <Button Text="Log Out"
                             TextColor="White"
                             BackgroundColor="Black"
                             CornerRadius="25"
                             HeightRequest="50"
                             HorizontalOptions="Fill"
                             Clicked="OnLogoutClicked"/>
              </VerticalStackLayout>

              <Grid Grid.Row="1"
                    ColumnDefinitions="*,*,*"
                    BackgroundColor="{DynamicResource BottomTabBarColor}"
                    HeightRequest="80">
                     <VerticalStackLayout Grid.Column="0"
                                          HorizontalOptions="Center"
                                          VerticalOptions="Center"
                                          Spacing="5">
                            <ImageButton Source="todo.png"
                                         WidthRequest="24"
                                         HeightRequest="24"
                                         HorizontalOptions="Center"
                                         Clicked="OnToDoTapped"/>
                            <Label Text="ToDo"
                                   FontSize="12"
                                   HorizontalOptions="Center"
                                   TextColor="Gray"/>
                     </VerticalStackLayout>
                     <VerticalStackLayout Grid.Column="1"
                                          HorizontalOptions="Center"
                                          VerticalOptions="Center"
                                          Spacing="5">
                            <ImageButton x:Name="completedButton"
                                         Source="check.png"
                                         WidthRequest="24"
                                         HeightRequest="24"
                                         HorizontalOptions="Center"
                                         BackgroundColor="Transparent"
                                         Clicked="OnCompleteTapped"/>
                            <Label Text="Completed"
                                   FontSize="12"
                                   HorizontalOptions="Center"
                                   TextColor="Gray"/>
                     </VerticalStackLayout>
                     <VerticalStackLayout Grid.Column="2"
                                          HorizontalOptions="Center"
                                          VerticalOptions="Center"
                                          Spacing="5">
                            <ImageButton Source="profile.png"
                                         WidthRequest="24"
                                         HeightRequest="24"
                                         HorizontalOptions="Center"/>
                            <Label Text="Profile"
                                   FontSize="12"
                                   HorizontalOptions="Center"
                                   TextColor="Black"/>
                     </VerticalStackLayout>
              </Grid>

              <!-- Loading Overlay -->
              <Grid x:Name="LoadingOverlay"
                    BackgroundColor="#80000080"
                    IsVisible="False"
                    VerticalOptions="FillAndExpand"
                    HorizontalOptions="FillAndExpand"
                    ZIndex="100">
                     <Frame Padding="30"
                            CornerRadius="16"
                            BackgroundColor="#CC222222"
                            HorizontalOptions="Center"
                            VerticalOptions="Center">
                            <ActivityIndicator IsRunning="True"
                                               VerticalOptions="Center"
                                               HorizontalOptions="Center"
                                               Color="White"
                                               WidthRequest="60"
                                               HeightRequest="60"/>
                     </Frame>
              </Grid>

       </Grid>
</ContentPage>